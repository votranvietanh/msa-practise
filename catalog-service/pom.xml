<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.8</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>catalog-service</artifactId>
    <version>1.0.0</version>
    <name>catalog-service</name>
    <description>Bai hoc rieng ve gRPC (4 kieu RPC) + Redis nang cao (Lua script, Sorted Set, Pub/Sub, rate limit)</description>

    <properties>
        <java.version>21</java.version>
        <!-- 2 version sau PHẢI khớp nhau: grpc-protobuf 1.84.0 build sẵn để dùng với
             protobuf-java 3.25.9 - dùng protobuf-java mới hơn (dòng 4.x) dễ gây lỗi
             "mismatched version" giữa code generate ra và runtime lúc chạy. -->
        <grpc.version>1.84.0</grpc.version>
        <protobuf.version>3.25.9</protobuf.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Không dùng spring-boot-starter-web (không có REST controller nào) nên Jackson
             KHÔNG tự có mặt trên classpath như 3 service kia - phải khai báo tay để
             ObjectMapper bean tồn tại cho việc serialize payload Pub/Sub (xem
             RedisProductEventPublisher/RedisProductWatchBridge). Không cần khai báo version
             vì đã được spring-boot-starter-parent quản lý (dependency management). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- grpc-netty-shaded: server/transport HTTP2 - bản "shaded" đóng gói sẵn Netty
             riêng, tránh xung đột version Netty với các thư viện khác trong classpath. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <!-- grpc-protobuf: cầu nối giữa gRPC và Protocol Buffers (serialize message). -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <!-- grpc-stub: sinh ra các lớp *Stub/*ImplBase từ file .proto (client/server API). -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <!-- grpc-services: chứa Server Reflection - cho phép công cụ như grpcurl liệt kê
             API mà KHÔNG cần có sẵn file .proto, rất tiện khi test tay. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-services</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <!-- javax.annotation.Generated: code sinh ra từ .proto có dùng annotation này,
             JDK 9+ đã bỏ nó ra khỏi bộ JDK chuẩn (JSR-250) nên phải khai báo thêm. -->
        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>annotations-api</artifactId>
            <version>6.0.53</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- grpc-inprocess: cho phép test gRPC service mà KHÔNG cần mở cổng TCP thật -
             chạy toàn bộ trong 1 process, rất nhanh và không xung đột port khi chạy song
             song nhiều test (xem CatalogGrpcServiceTest). -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <version>${grpc.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <!-- os-maven-plugin: phát hiện hệ điều hành/kiến trúc CPU đang build (Windows,
                 macOS, Linux...) để chọn đúng file thực thi protoc/protoc-gen-grpc-java
                 tương ứng ở bước generate code bên dưới (${os.detected.classifier}). -->
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Cho phép chạy CatalogClientDemo bằng: mvn exec:java
                 -Dexec.mainClass=com.example.catalog.client.CatalogClientDemo -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
            </plugin>
            <!-- Bước quan trọng nhất để "biết" gRPC hoạt động thế nào: plugin này đọc
                 src/main/proto/*.proto và SINH RA CODE JAVA (message class + service
                 stub) vào target/generated-sources/protobuf/ trước khi javac chạy.
                 Đây là lý do IDE có thể "không thấy" các class như CatalogServiceGrpc
                 cho tới khi chạy `mvn compile` ít nhất 1 lần. -->
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>0.6.1</version>
                <configuration>
                    <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
                    <pluginId>grpc-java</pluginId>
                    <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>compile-custom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
